{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "customer-capability",
  "description": "Restricted capability for the customer facing window",
  "windows": ["customer"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "printer:allow-print-pdf",
    "http:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://dealioerp.vercel.app" }
      ]
    }
  ]
}